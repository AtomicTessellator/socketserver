{
  "$schema": "https://json.schemastore.org/github-ruleset.json",
  "_meta": {
    "compliance": "SOC 2 / ISO 27001",
    "description": "Staging branch protection — merges blocked from main; no cloudbuild config changes via PR. No Cloud Build gate: the only build trigger is manual (public repo). No human approval required."
  },
  "name": "SOC: staging branch protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/staging"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "creation" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "SOC: verify merge source is not main"
          },
          {
            "context": "SOC: no cloudbuild config change into staging"
          }
        ]
      }
    }
  ]
}
